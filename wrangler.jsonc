/**
 * Wrangler configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflows-starter-template",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },

  /**
   * Workflow definition
   * https://developers.cloudflare.com/workflows/
   */
  "workflows": [
    {
      "name": "my-workflow",
      "binding": "MY_WORKFLOW",
      "class_name": "MyWorkflow"
    }
  ],

  /**
   * Durable Object binding for workflow status.
   */
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKFLOW_STATUS",
        "class_name": "WorkflowStatusDO"
      }
    ]
  },

  /**
   * Required once per DO class.
   */
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkflowStatusDO"]
    }
  ],

  "upload_source_maps": true,

  /**
   * Non-secret vars. Secrets (API_TOKEN, ALLOWED_ORIGINS) go in
   * `wrangler secret put` for production, and in `.dev.vars` for local.
   */
  "vars": {}
}
